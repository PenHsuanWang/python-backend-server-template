# Local clean baseline: no application modules and optional product services disabled.
# Copy to .env; never commit real credentials. Environment variables override this file.
APP_APP_NAME=Python Backend Platform
APP_ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_WORKERS=1
APP_RELOAD=false
APP_LOG_LEVEL=info

# disabled: no background jobs; multiple API processes without a broker.
# memory: development/test, one API process; distributed: shared RabbitMQ/Redis jobs.
# Production accepts disabled or distributed; memory is development-only.
APP_TASK_BACKEND=memory
APP_EXPOSE_JOB_API=false
APP_TASK_CONCURRENCY=4
APP_TASK_QUEUE_SIZE=100
APP_JOB_MAX_RECORDS=1000
APP_JOB_RETENTION_SECONDS=3600
APP_JOB_TIMEOUT_SECONDS=60
APP_SHUTDOWN_TIMEOUT_SECONDS=10
APP_HTTP_TIMEOUT_SECONDS=10

# Per-process bounded execution for blocking I/O; this is not a CPU process pool.
APP_THREAD_WORKERS=4
APP_THREAD_QUEUE_SIZE=16
APP_PASSWORD_HASH_CONCURRENCY=2

# Optional NoSQL/identity. Compose enables both and overrides the URI for its network.
APP_MONGO_ENABLED=false
APP_MONGO_URI=mongodb://127.0.0.1:27017
APP_MONGO_DATABASE=backend
APP_MONGO_POOL_SIZE=20
APP_IDENTITY_ENABLED=false
APP_JWT_SECRET=
APP_JWT_ISSUER=backend
APP_JWT_AUDIENCE=backend-api
APP_ACCESS_TOKEN_SECONDS=900

# Before using Compose, generate TWO independent values with: openssl rand -hex 32
# Paste one into APP_JWT_SECRET above and the other here. No default application account.
# Use a hex password here; other characters require URI percent-encoding in Compose.
MONGO_ROOT_PASSWORD=

# Empty registries by default. API switches do not install kernels or export sources.
APP_KERNEL_API_ENABLED=false
APP_EXPORTS_API_ENABLED=false
APP_KERNEL_TIMEOUT_SECONDS=30
APP_RESOURCE_BACKEND=memory
APP_RESOURCE_LIMITS={"compute":1}
APP_RESOURCE_LEASE_SECONDS=30

# Local infrastructure. Compose overrides hostnames and uses Redis resource coordination.
# These RabbitMQ credentials are for local development only.
APP_WORKER_PROCESSES=2
APP_RABBITMQ_URL=amqp://backend:local-backend-password@127.0.0.1:5672/
APP_REDIS_URL=redis://127.0.0.1:6379/0
APP_QUEUE_NAME=backend.jobs
